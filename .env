PORT=8002
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=english_tutor

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES=7d

# 聊天 LLM（AiService 用, 智谱兼容端点; 与语音模块无关, 勿删）
OPENAI_API_KEY=
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4.5-air

# 语音后端（speech 模块, 阿里云百炼 DashScope）
DASHSCOPE_API_KEY=
SPEECH_ASR_PROVIDER=dashscope
SPEECH_ASR_MODEL=qwen3-asr-flash
SPEECH_TTS_PROVIDER=dashscope
SPEECH_TTS_MODEL=qwen-audio-3.0-tts-flash
SPEECH_TTS_VOICE=longanhuan_v3.6
