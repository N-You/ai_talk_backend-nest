PORT=8002
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=english_tutor

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES=7d

OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 语音后端 (speech 模块, 阿里云百炼 DashScope)
DASHSCOPE_API_KEY=
SPEECH_ASR_PROVIDER=dashscope
SPEECH_ASR_MODEL=qwen3-asr-flash
# ASR 逆文本正则化 (默认 false)：true 时 "one hundred twenty three" 识别为 "123"，
# 英语学习场景建议保持 false（保留数字原文）
SPEECH_ASR_ENABLE_ITN=false
# ASR 语言提示 (asr_options.language)。三档：
#   （留空）    = 自动检测（默认，推荐混合场景；官方明确：中英混合时不要指定语言）
#   en          = 纯英文对话场景，显著提升英文准确率（牺牲中文识别）
#   zh          = 纯中文场景
SPEECH_ASR_LANGUAGE=
SPEECH_TTS_PROVIDER=dashscope
SPEECH_TTS_MODEL=qwen-audio-3.0-tts-flash
SPEECH_TTS_VOICE=longanhuan_v3.6
